
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum SaleStatus {
  ACTIVE
  PAID
  CANCELLED
  WRITTEN_OFF
}

enum PaymentStatus {
  POSTED
  VOIDED
}

enum ImportModule {
  CUSTOMERS
}

enum ImportJobStatus {
  READY
  PROCESSING
  COMPLETED
  PARTIAL
  NO_CHANGES
  FAILED
}

enum CustomerPhoneType {
  PRIMARY
  ADDITIONAL
}

model Employee {
  id          String   @id @default(cuid())
  fullName    String
  mobile      String?
  address     String?
  commissionRate Decimal @default(10.00) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?
  sales          Sale[]
  collections    Payment[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee? @relation(fields: [employeeId], references: [id])
  collectionBatches CollectionBatch[]
  auditLogs AuditLog[]
  importJobs ImportJob[]
}

model Customer {
  id               String   @id @default(cuid())
  fullName         String
  nic              String   @unique
  mobile           String   @unique
  additionalMobile String?
  address          String
  area             String?
  guarantorDetails String?  @db.Text
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sales  Sale[]
  phones CustomerPhone[]
}

model CustomerPhone {
  id              String            @id @default(cuid())
  customerId      String
  type            CustomerPhoneType
  normalizedPhone String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}


model Brand {
  id           String         @id @default(cuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  productBrands ProductBrand[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  categoryId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       ProductCategory @relation(fields: [categoryId], references: [id])
  productBrands  ProductBrand[]
  saleItems      SaleItem[]
}

model ProductBrand {
  id             String   @id @default(cuid())
  productId      String
  brandId        String
  price          Decimal  @db.Decimal(12, 2)
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id])
  brand          Brand    @relation(fields: [brandId], references: [id])
  saleItems      SaleItem[]

  @@unique([productId, brandId])
  @@index([brandId])
}

model Sale {
  id               String     @id @default(cuid())
  billNumber       String     @unique
  customerId       String
  salesEmployeeId  String?
  saleDate         DateTime   @default(now())
  totalAmount      Decimal    @db.Decimal(12, 2)
  advancePayment   Decimal    @default(0) @db.Decimal(12, 2)
  notes            String?    @db.Text
  status           SaleStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer         Customer   @relation(fields: [customerId], references: [id])
  customerSnapshot SaleCustomerSnapshot?
  salesEmployee    Employee?  @relation(fields: [salesEmployeeId], references: [id])
  items            SaleItem[]
  installments     Installment[]
  payments         Payment[]
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  productId      String
  productBrandId String?
  productName    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  sale           Sale          @relation(fields: [saleId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  productBrand   ProductBrand? @relation(fields: [productBrandId], references: [id])
}

model SaleCustomerSnapshot {
  id               String   @id @default(cuid())
  saleId           String   @unique

  fullName         String
  nic              String
  mobile           String
  additionalMobile String?
  address          String
  area             String?
  guarantorDetails String?  @db.Text

  createdAt        DateTime @default(now())

  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Installment {
  id                String   @id @default(cuid())
  saleId            String
  installmentNumber Int
  dueDate           DateTime
  scheduledAmount   Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sale              Sale               @relation(fields: [saleId], references: [id])
  allocations       PaymentAllocation[]

  @@unique([saleId, installmentNumber])
  @@index([dueDate])
}

model CollectionBatch {
  id                String   @id @default(cuid())
  collectionDate    DateTime
  enteredByUserId   String
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  enteredBy         User      @relation(fields: [enteredByUserId], references: [id])
  payments          Payment[]

  @@index([collectionDate])
}

model Payment {
  id                String        @id @default(cuid())
  saleId            String
  collectionBatchId String
  collectedById     String
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime
  status            PaymentStatus @default(POSTED)
  commissionRate    Decimal       @default(10.00) @db.Decimal(5, 2)
  commissionAmount  Decimal       @db.Decimal(12, 2)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sale              Sale               @relation(fields: [saleId], references: [id])
  collectionBatch   CollectionBatch    @relation(fields: [collectionBatchId], references: [id])
  collectedBy       Employee           @relation(fields: [collectedById], references: [id])
  allocations       PaymentAllocation[]

  @@index([paymentDate])
  @@index([collectedById, paymentDate])
  @@index([saleId])
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String
  installmentId String
  amount        Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  payment       Payment     @relation(fields: [paymentId], references: [id])
  installment   Installment @relation(fields: [installmentId], references: [id])

  @@unique([paymentId, installmentId])
}

model Vehicle {
  id                    String    @id @default(cuid())
  registrationNumber    String    @unique
  vehicleType           String
  licenceExpiryDate     DateTime?
  insuranceExpiryDate   DateTime?
  lastMaintenanceDate   DateTime?
  currentOdometerKm     Int?
  nextMaintenanceAtKm   Int?
  notes                 String?   @db.Text

  @@index([licenceExpiryDate])
  @@index([insuranceExpiryDate])
}


model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  entityType   String
  entityId     String
  reason       String?  @db.Text
  beforeData   Json?
  afterData    Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ImportJob {
  id                String          @id @default(cuid())
  sessionKey        String          @unique @db.VarChar(64)
  module            ImportModule
  payloadDigest     String          @db.VarChar(64)
  originalFilename  String          @db.VarChar(255)
  uploadedRowCount  Int
  importedCount     Int             @default(0)
  skippedCount      Int             @default(0)
  invalidCount      Int             @default(0)
  duplicateCount    Int             @default(0)
  failedCount       Int             @default(0)
  status            ImportJobStatus @default(READY)
  batchSize         Int             @default(100)
  totalBatches      Int             @default(0)
  nextBatchIndex    Int             @default(0)
  candidateRows     Json?
  attemptCount      Int             @default(0)
  leaseToken        String?         @db.VarChar(64)
  leaseExpiresAt    DateTime?
  failureCode       String?         @db.VarChar(100)
  initiatedByUserId String
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  initiatedBy User @relation(fields: [initiatedByUserId], references: [id])

  @@index([module, createdAt])
  @@index([initiatedByUserId, createdAt])
  @@index([status, leaseExpiresAt])
}
